{
  "name": "world-of-adventure-mod-creator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:pages": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release-windows server.js",
    "lint": "tsc --noEmit",
    "sync:version": "node scripts/sync-version.mjs",
    "electron:build": "node scripts/build-electron.mjs && node scripts/generate-win-icon.mjs",
    "build:windows": "npm run sync:version && set \"VITE_TARGET=electron\" && set \"VITE_DISABLE_PWA=true\" && vite build && npm run electron:build",
    "pack:windows": "npm run build:windows && npx electron-builder --win portable nsis --publish never --config electron-builder.yml",
    "android:sync": "npm run sync:version && VITE_TARGET=capacitor VITE_DISABLE_PWA=true vite build && npx cap sync android",
    "test": "npx tsx --test tests/crossPlatform.test.ts"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
